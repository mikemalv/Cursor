# Personal Cursor account key -- NOT a company-managed account.
# Company-managed accounts restrict models and advanced SDK features.
CURSOR_API_KEY=

# local | cloud  -- keep this a flag, never hardcode. Interviewers will ask you to flip it.
PITBOSS_RUNTIME=local

# Repo the agents operate on
PITBOSS_TARGET_REPO=./demo-repo/regal-gaming-platform
