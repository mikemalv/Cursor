# Personal Cursor account key — not a company-managed one.
# https://cursor.com/dashboard/api
CURSOR_API_KEY=

# composer-2.5 is the documented default for most SDK integrations.
COUNTROOM_MODEL=composer-2.5

# fixture (default): recorded warehouse answers, no network.
# live: Cursor SDK agents + optional Snowflake.
COUNTROOM_MODE=fixture
